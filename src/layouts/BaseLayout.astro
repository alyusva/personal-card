---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Alvaro Yuste Valles - Process Engineer & AI/ML Developer",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/destello.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- No external fonts needed for Apple System Font stack -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header glass">
      <div class="header-container container">
        <a href="#" class="logo">AYV</a>
        <nav>
          <div class="nav-links">
            <a href="#about">About</a>
            <a href="#experience">Experience</a>
            <a href="#projects">Projects</a>
          </div>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    z-index: 100;
    /* Glass effect handled by utility class in global.css */
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-links {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
      gap: var(--space-md);
    }

    .nav-links a {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
      text-decoration: none;
      font-weight: 500;
    }

    .nav-links a:hover {
      color: var(--color-text-primary);
      text-decoration: none;
    }
  }

  main {
    padding-top: 60px; /* Offset for fixed header */
  }
</style>
