---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import Analytics from "@vercel/analytics/astro";

const pageTitle = "Alvaro Yuste Valles | Process Engineer | AI Developer";
---

<BaseLayout title={pageTitle}>
	<Hero
		name="Alvaro Yuste Valles"
		position="Process Engineer | AI Developer"
		cvLink="/files/CV Alvaro Yuste Valles.pdf"
	/>

	<About profileImage="/images/IMG_5575.jpeg" />

	<Experience />

	<Education />

	<Projects />

	<Contact />

	<Analytics />
</BaseLayout>
